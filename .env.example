# Copy this file to .env and fill in your values

# ── Required ──────────────────────────────────────────────────────────────────

# Claude API key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Secret used to sign auth tokens. Generate with: openssl rand -hex 32
# If unset, a random secret is used and all sessions reset on restart.
JWT_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────

# Override the default model
# CLAUDE_MODEL=claude-sonnet-4-6

# Apollo.io API key — unlocks LIVE company & contact data for the VANTAGE
# sales agent. Without it, VANTAGE runs on clearly-marked demo data.
# Get a key at https://app.apollo.io/#/settings/integrations/api
# APOLLO_API_KEY=

# Auth token lifetime in hours (default 72)
# AUTH_TOKEN_TTL_HOURS=72
