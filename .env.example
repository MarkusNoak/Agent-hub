# ============================================================
# Agent Hub — Environment Configuration
# ============================================================
# Copy to .env.local for local dev, set in Railway for prod.

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
AGENT_MAX_ITERATIONS=25

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-side only, NEVER expose to client

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
AGENT_HUB_BASE_URL=http://localhost:3000

# --- Tenant bootstrap (first install) ---
BOOTSTRAP_TENANT_SLUG=we-know-it
BOOTSTRAP_TENANT_NAME=We Know IT AB
BOOTSTRAP_ADMIN_EMAIL=markus@weknowit.se

# --- Integrations (per-tenant secrets normally live in integrations table) ---
# These are fallback defaults used only if integrations row is missing.
VISMA_CLIENT_ID=
VISMA_CLIENT_SECRET=
VISMA_REDIRECT_URI=http://localhost:3000/api/integrations/visma/callback

FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=

CLOCKIFY_API_KEY=
TRELLO_API_KEY=
TRELLO_TOKEN=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Signal sources (Sales Agent) ---
APOLLO_API_KEY=
NEWS_API_KEY=
