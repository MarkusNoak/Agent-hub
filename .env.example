# Copy this file to .env and fill in your values

# ── Required ──────────────────────────────────────────────────────────────────

# Claude API key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Secret used to sign auth tokens. Generate with: openssl rand -hex 32
# If unset, a random secret is used and all sessions reset on restart.
JWT_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────

# Override the default model
# CLAUDE_MODEL=claude-sonnet-4-6

# Apollo.io API key — unlocks LIVE company & contact data for the VANTAGE
# sales agent. Without it, VANTAGE runs on clearly-marked demo data.
# Get a key at https://app.apollo.io/#/settings/integrations/api
# APOLLO_API_KEY=

# Auth token lifetime in hours (default 72)
# AUTH_TOKEN_TTL_HOURS=72

# Companies House (UK) — free API key unlocks official UK registry lookups
# for VANTAGE. Register at https://developer.company-information.service.gov.uk
# COMPANIES_HOUSE_API_KEY=

# ── Outreach (email sequences) ────────────────────────────────────────────────
# Without EMAIL_ENABLED=true all sends are SIMULATED (logged, nothing sent).
# EMAIL_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=hej@weknowit.se

# Inbound reply detection (IMAP polling)
# IMAP_HOST=imap.example.com
# IMAP_USER=
# IMAP_PASS=

# Public base URL used in unsubscribe links
# APP_BASE_URL=https://hub.weknowit.se

# Reply classification model (needs ANTHROPIC_API_KEY; falls back to
# Swedish keyword heuristics without it)
# CLASSIFIER_MODEL=claude-haiku-4-5

# TED procurement API key (optional — anonymous access is rate-limited)
# TED_API_KEY=
